# {{ ansible_managed }}
{
	email {{ acme_email }}
}

{{ aiostreams_domain }} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy 127.0.0.1:{{ aiostreams_port }}
}
