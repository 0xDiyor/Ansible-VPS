# {{ ansible_managed }}
# Bootstrap settings only. Everything else is configured in the dashboard.
BASE_URL=https://{{ aiostreams_domain }}
SECRET_KEY={{ aiostreams_secret_key }}
DATABASE_URI=sqlite://./data/db.sqlite
AIOSTREAMS_AUTH={{ aiostreams_auth }}
# Without this the config page is public and anyone can use this instance.
AIOSTREAMS_AUTH_REQUIRED=true
LOG_FORMAT=json
{% for key, value in aiostreams_extra_env.items() %}
{{ key }}={{ value }}
{% endfor %}
