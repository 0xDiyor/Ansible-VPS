# {{ ansible_managed }}
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_user }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ hermes_dashboard_password }}
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_secret }}
{% if tailscale_dns_name is defined %}
# The tailnet address `tailscale serve` publishes the dashboard on.
HERMES_DASHBOARD_PUBLIC_URL=https://{{ tailscale_dns_name }}:{{ hermes_dashboard_tailnet_port }}
{% endif %}
