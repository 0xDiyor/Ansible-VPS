# Template for group_vars/all/vault.yml. Copy it, fill it in, then encrypt:
#   cp vault.yml.example group_vars/all/vault.yml
#   ansible-vault encrypt group_vars/all/vault.yml
# (uses .vault_pass: printf '%s' 'your-vault-password' > .vault_pass)
# Edit later with: ansible-vault edit group_vars/all/vault.yml

# Your sudo password on the VPS
vault_admin_password: "CHANGE_ME"

# openssl rand -hex 32  (NEVER change this after first start, or AIOStreams
# can no longer decrypt saved user configs)
vault_aiostreams_secret_key: "CHANGE_ME_64_HEX_CHARS"

# Dashboard login for AIOStreams
vault_aiostreams_auth: "admin:CHANGE_ME_LONG_RANDOM_PASSWORD"

# Anything Hermes reads from its environment. Keep only what you use.
vault_hermes_env:
  OPENROUTER_API_KEY: "sk-or-CHANGE_ME"
  # ANTHROPIC_API_KEY: ""
  # TELEGRAM_BOT_TOKEN: ""
  # Without this, anyone who finds your bot can command it. Use your numeric Telegram user ID.
  # TELEGRAM_ALLOWED_USERS: "123456789"

# Hermes dashboard login (user is hermes_dashboard_user in vars.yml)
vault_hermes_dashboard_password: "CHANGE_ME_LONG_RANDOM_PASSWORD"
# openssl rand -base64 32
vault_hermes_dashboard_secret: "CHANGE_ME"

# Optional: Tailscale auth key to log in without a browser
# vault_tailscale_authkey: "tskey-auth-CHANGE_ME"
